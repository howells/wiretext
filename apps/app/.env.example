# Wiretext web editor environment variables.
# Every variable below is consumed only by apps/app. Copy this file to
# .env.local and fill in real values. All of them are optional — a clone with
# no .env still boots the full editor, with sharing via hash (#…) URLs.

# --- Short-link sharing (Upstash Redis) ---------------------------------------
# Required together to enable the /api/share endpoint that mints short /w/:id
# links (used by `wiretext share` and the MCP create_wireframe tool).
# Without them, /api/share responds 503 and short links are unavailable; the
# editor and hash-URL (#…) sharing keep working, since those store the document
# in the URL rather than server-side.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# --- Analytics (PostHog) ------------------------------------------------------
# Optional. Enables PostHog product analytics in the editor. When unset,
# analytics is a no-op and everything else works unchanged.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
