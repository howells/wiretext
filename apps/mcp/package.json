{
  "name": "@wiretext/mcp",
  "version": "0.3.3",
  "description": "MCP server for generating editable Wiretext wireframes and terminal-rendered layouts.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://wiretext.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/wiretext.git",
    "directory": "apps/mcp"
  },
  "keywords": [
    "mcp",
    "wireframes",
    "ascii",
    "unicode",
    "ai-agents",
    "design-tools"
  ],
  "bin": {
    "wiretext-mcp": "./dist/server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "howells-lint",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^25.3.5",
    "@wiretext/engine": "workspace:*",
    "@wiretext/schemas": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  }
}
