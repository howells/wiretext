{
  "name": "@wiretext/mcp",
  "version": "0.3.3",
  "description": "MCP server for generating editable Wiretext wireframes and terminal-rendered layouts.",
  "keywords": [
    "ai-agents",
    "ascii",
    "design-tools",
    "mcp",
    "unicode",
    "wireframes"
  ],
  "homepage": "https://wiretext.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/wiretext.git",
    "directory": "apps/mcp"
  },
  "bin": {
    "wiretext-mcp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/node": "^26.1.1",
    "@wiretext/engine": "workspace:*",
    "@wiretext/schemas": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
