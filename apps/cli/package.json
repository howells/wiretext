{
  "name": "wiretext",
  "version": "0.3.4",
  "description": "Agent-first CLI for generating editable ASCII and Unicode wireframes from structured JSON.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://wiretext.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/wiretext.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "wireframes",
    "ascii",
    "unicode",
    "cli",
    "mcp",
    "ai-agents",
    "design-tools"
  ],
  "bin": {
    "wiretext": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CONTEXT.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "howells-lint",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@wiretext/engine": "workspace:*",
    "@wiretext/schemas": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@howells/cli": "^0.1.0"
  }
}
