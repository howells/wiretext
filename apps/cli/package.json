{
  "name": "wiretext",
  "version": "0.3.4",
  "description": "Agent-first CLI for generating editable ASCII and Unicode wireframes from structured JSON.",
  "keywords": [
    "ai-agents",
    "ascii",
    "cli",
    "design-tools",
    "mcp",
    "unicode",
    "wireframes"
  ],
  "homepage": "https://wiretext.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commoninstruments/wiretext.git",
    "directory": "apps/cli"
  },
  "bin": {
    "wiretext": "./dist/index.js"
  },
  "files": [
    "dist",
    "CONTEXT.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "howells-check .",
    "lint:fix": "howells-fix .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@wiretext/engine": "workspace:*",
    "@wiretext/schemas": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
