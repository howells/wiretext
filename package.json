{
  "name": "wiretext-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@wiretext/app",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "check": "turbo typecheck lint",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css}": "biome format --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "husky": "9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "^2.8.14",
    "ultracite": "7.2.5"
  }
}
