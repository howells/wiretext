{
  "name": "wiretext-monorepo",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@wiretext/app",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "howells-lint",
    "format": "howells-format",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "howells-husky",
    "dev:all": "turbo run dev --parallel",
    "clean": "turbo clean",
    "check:affected": "turbo run build lint typecheck test --affected"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css}": "howells-format"
  },
  "devDependencies": {
    "@howells/husky": "^0.1.0",
    "@howells/lint": "^0.1.3",
    "turbo": "2.9.3"
  }
}
