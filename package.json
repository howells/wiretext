{
  "name": "wiretext-monorepo",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@wiretext/app",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky",
    "dev:all": "turbo run dev --parallel",
    "clean": "turbo clean",
    "check:affected": "turbo run build lint typecheck test --affected"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css}": "biome format --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "husky": "9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "2.9.3",
    "ultracite": "7.3.2"
  }
}
