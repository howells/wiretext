{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "extends": ["@howells/lint/biome/core"],
  "root": true,
  "vcs": {
    "useIgnoreFile": false
  },
  "overrides": [
    {
      "includes": ["**/src/index.ts", "**/src/index.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
